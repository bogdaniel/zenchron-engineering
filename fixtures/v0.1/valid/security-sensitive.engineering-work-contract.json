{
  "schema_version": "0.1",
  "id": "contract-auth-session",
  "revision": "1",
  "objective": "Change session refresh validation.",
  "acceptance_intent": ["Valid sessions refresh", "Invalid sessions remain rejected"],
  "subject": {
    "repository": "acme/payments",
    "revision": "rev-b"
  },
  "scope": {
    "stage": "observed",
    "allowed_paths": ["internal/auth/session.go", "internal/auth/session_test.go"],
    "prohibited_paths": ["deploy/**"]
  },
  "facts": ["fact-auth-2"],
  "invariants": {
    "AUTH-001": { "statement": "Authentication protections must not weaken." }
  },
  "obligations": {
    "auth-regression-tests": { "statement": "Authentication regression tests must pass." },
    "independent-security-review": { "statement": "An independent security review must approve the change." },
    "security-owner-approval": { "statement": "The security owner must approve merge." }
  },
  "required_claims": {
    "claim-auth-regression-tests": {
      "evidence_class": "test_result",
      "independent_from_change_producer": true
    },
    "claim-security-review": {
      "evidence_class": "security_review",
      "independent_from_change_producer": true
    },
    "claim-security-owner-approval": {
      "evidence_class": "human_approval",
      "independent_from_change_producer": true
    }
  },
  "permissions": [
    { "type": "git.pull_request.create", "target": "main" },
    { "type": "git.merge", "target": "main" }
  ],
  "prohibitions": [
    { "type": "deploy.production", "target": "payments" }
  ],
  "authority_conditions": [
    {
      "action": { "type": "git.merge", "target": "main" },
      "required_claims": [
        "claim-auth-regression-tests",
        "claim-security-review",
        "claim-security-owner-approval"
      ]
    }
  ],
  "provenance": {
    "project_model": { "id": "project-acme-payments", "revision": "1" },
    "policy": { "id": "policy-engineering-baseline", "revision": "1" },
    "compiler_version": "compiler-v0.1"
  }
}
