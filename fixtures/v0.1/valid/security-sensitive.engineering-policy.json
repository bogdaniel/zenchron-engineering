{
  "schema_version": "0.1",
  "id": "policy-engineering-baseline",
  "revision": "1",
  "rules": {
    "TRIVIAL-CHANGE-001": {
      "when": {
        "fact": "authentication.boundary_modified",
        "equals": false
      },
      "effect": {
        "required_claims": {
          "claim-trivial-validation": {
            "evidence_class": "test_result",
            "independent_from_change_producer": true
          },
          "claim-semantic-acceptance": {
            "evidence_class": "semantic_acceptance",
            "independent_from_change_producer": true
          }
        },
        "obligations": {
          "trivial-change-validation": {
            "statement": "Basic change validation must pass.",
            "required_claims": [
              "claim-trivial-validation"
            ]
          }
        },
        "permissions": [
          {
            "type": "git.pull_request.create",
            "target": "main"
          }
        ],
        "authority_conditions": [
          {
            "action": {
              "type": "git.pull_request.create",
              "target": "main"
            },
            "required_claims": [
              "claim-trivial-validation"
            ]
          }
        ],
        "acceptance_discharge_claims": [
          "claim-semantic-acceptance"
        ]
      }
    },
    "API-BEHAVIOR-001": {
      "when": {
        "fact": "api.behavior_modified",
        "equals": true
      },
      "effect": {
        "required_claims": {
          "claim-api-behavior-tests": {
            "evidence_class": "test_result",
            "independent_from_change_producer": true
          },
          "claim-api-contract-tests": {
            "evidence_class": "test_result",
            "independent_from_change_producer": true
          },
          "claim-semantic-acceptance": {
            "evidence_class": "semantic_acceptance",
            "independent_from_change_producer": true
          }
        },
        "obligations": {
          "api-behavior-tests": {
            "statement": "API behavior and compatibility tests must pass.",
            "required_claims": [
              "claim-api-behavior-tests",
              "claim-api-contract-tests"
            ]
          }
        },
        "permissions": [
          {
            "type": "git.pull_request.create",
            "target": "main"
          }
        ],
        "authority_conditions": [
          {
            "action": {
              "type": "git.pull_request.create",
              "target": "main"
            },
            "required_claims": [
              "claim-api-behavior-tests",
              "claim-api-contract-tests"
            ]
          }
        ],
        "acceptance_discharge_claims": [
          "claim-semantic-acceptance"
        ]
      }
    },
    "AUTH-BOUNDARY-001": {
      "when": {
        "fact": "authentication.boundary_modified",
        "equals": true
      },
      "effect": {
        "required_claims": {
          "claim-auth-regression-tests": {
            "evidence_class": "test_result",
            "independent_from_change_producer": true
          },
          "claim-security-review": {
            "evidence_class": "security_review",
            "independent_from_change_producer": true
          },
          "claim-security-owner-approval": {
            "evidence_class": "human_approval",
            "independent_from_change_producer": true
          },
          "claim-semantic-acceptance": {
            "evidence_class": "semantic_acceptance",
            "independent_from_change_producer": true
          }
        },
        "obligations": {
          "auth-regression-tests": {
            "statement": "Authentication regression tests must pass.",
            "required_claims": [
              "claim-auth-regression-tests"
            ]
          },
          "independent-security-review": {
            "statement": "An independent security review must approve the change.",
            "required_claims": [
              "claim-security-review"
            ]
          },
          "security-owner-approval": {
            "statement": "The security owner must approve merge.",
            "required_claims": [
              "claim-security-owner-approval"
            ]
          }
        },
        "invariants": {
          "AUTH-001": {
            "statement": "Authentication protections must not weaken."
          }
        },
        "authority_conditions": [
          {
            "action": {
              "type": "git.merge",
              "target": "main"
            },
            "required_claims": [
              "claim-auth-regression-tests",
              "claim-security-review",
              "claim-security-owner-approval"
            ]
          }
        ],
        "acceptance_discharge_claims": [
          "claim-semantic-acceptance"
        ]
      }
    },
    "SENSITIVE-DATA-UNKNOWN-001": {
      "when": {
        "fact": "sensitive_data.boundary_modified",
        "equals": "unknown",
        "stage": "predicted",
        "confidence": "low",
        "provenance": {
          "type": "intent_analysis"
        }
      },
      "effect": {
        "obligations": {
          "resolve-sensitive-data-impact": {
            "statement": "Resolve whether the change modifies a sensitive-data boundary."
          }
        },
        "prohibitions": [
          {
            "type": "git.merge",
            "target": "main"
          }
        ],
        "required_claims": {
          "claim-semantic-acceptance": {
            "evidence_class": "semantic_acceptance",
            "independent_from_change_producer": true
          }
        },
        "acceptance_discharge_claims": [
          "claim-semantic-acceptance"
        ]
      }
    }
  }
}
