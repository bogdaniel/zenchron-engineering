  "whole": [
    "runtime/operations.go"
  ],
  "domains": [
    {
      "name": "guards",
      "why": "Source-scan guards: cheap structural invariants every runtime change must keep.",
      "always": true,
      "run": [
        "TestEveryOperationKindIsClassifiedDeliberately",
        "TestNoProductionCodeReadsStateDigestsAsAuthority",
        "TestPostCommitReadersUseTheSubjectStore",
        "TestEveryExecutionRequestProducerSuppliesTheSchedulerAttempt",
        "TestEveryRunPolicyMemberIsFrozenAtCreation",
        "TestEveryPathFieldDeclaresItsRecordedForm"
      ]
    },
    {
      "name": "adoption",
      "why": "Trusted-main adoption: trust root, governance observation, adopted builds and credential boundaries.",
      "race": true,
      "sources": [
