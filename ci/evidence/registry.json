{
  "schema": "zenchron-evidence-registry/1",
  "focused_package": "runtime",
  "inert": [
    "**/*.md",
    "docs/**",
    ".github/**",
    ".claude/**",
    "agentkernel/**",
    "ci/**",
    "scripts/**",
    "benchmarks/**",
    "file-size-exceptions.tsv",
    ".gitignore",
    "LICENSE"
