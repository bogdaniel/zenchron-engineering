{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "outcome",
    "resolved_at"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "allow_deny",
            "selected_option",
            "text"
          ]
        },
        "value": {
          "type": "string"
        }
      }
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
