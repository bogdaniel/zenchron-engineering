{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenchron.engineering/schemas/v0.1/control-plane-run.schema.json",
  "title": "Control plane: GET /v1/runs/{run_id}",
  "description": "One runtime.RunSummary, the same projection runtime.FleetStatus produces for the run inside its Runs list.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "repository", "phase", "disposition", "elapsed"],
  "properties": {
    "run_id": { "type": "string" },
    "repository": { "type": "string" },
    "issue": { "type": "integer" },
    "agent": { "type": "string" },
    "provider_kind": { "type": "string" },
    "trust_mode": { "type": "string" },
    "model": { "type": "string" },
    "phase": { "type": "string" },
    "disposition": { "type": "string" },
    "reason": { "type": "string" },
    "operation": { "type": "string" },
    "attempt": { "type": "integer" },
    "executing": { "type": "boolean" },
    "elapsed": { "type": "integer", "description": "nanoseconds (time.Duration)" },
    "branch": { "type": "string" },
    "candidate_revision": { "type": "string" },
    "candidate_tree": { "type": "string" },
    "workspace": { "type": "string" },
    "pull_request": { "type": "integer" },
    "pull_request_state": { "type": "string" },
    "ci": { "type": "string" },
    "review": { "type": "string" },
    "feedback_admitted": { "type": "integer" },
    "feedback_pending": { "type": "integer" },
    "attempts": { "type": "object", "additionalProperties": { "type": "integer" } },
    "error": { "type": "string" }
  }
}
