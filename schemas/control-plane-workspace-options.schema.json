{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repositories",
    "agents",
    "profiles",
    "templates",
    "instruction_packs",
    "context_policies",
    "budget"
  ],
  "properties": {
    "repositories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "instruction_packs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context_policies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "trust_mode",
          "default",
          "eligible"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "trust_mode": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "default": {
            "type": "boolean"
          },
          "eligible": {
            "type": "boolean"
          }
        }
      }
    },
    "budget": {
      "$ref": "#/$defs/budget_envelope"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/non_empty_string"
        },
        "revision": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "plan_stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "kind": {
          "enum": [
            "agent",
            "assurance_gate",
            "human_decision_gate"
          ]
        },
        "role": {
          "$ref": "https://zenchron.engineering/schemas/v0.1/planning-vocabulary.schema.json#/$defs/role"
        },
        "objective": {
          "$ref": "#/$defs/non_empty_string"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "requires_capabilities": {
          "type": "array",
          "items": {
            "$ref": "https://zenchron.engineering/schemas/v0.1/planning-vocabulary.schema.json#/$defs/capability"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "independence": {
          "$ref": "#/$defs/independence"
        },
        "trust_requirement": {
          "enum": [
            "operator_trusted",
            "protected"
          ]
        },
        "invocation_mode": {
          "enum": [
            "mutating",
            "non_mutating_planning"
          ]
        },
        "profile": {
          "$ref": "#/$defs/non_empty_string"
        },
        "context_policy": {
          "$ref": "#/$defs/non_empty_string"
        },
        "required_claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "budget": {
          "$ref": "#/$defs/stage_budget"
        },
        "rationale": {
          "$ref": "#/$defs/non_empty_string"
        },
        "substitutes_role": {
          "$ref": "https://zenchron.engineering/schemas/v0.1/planning-vocabulary.schema.json#/$defs/role"
        },
        "execution_kind": {
          "type": "string",
          "enum": [
            "provider",
            "integration_compose"
          ]
        }
      }
    },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "different_from"
      ],
      "properties": {
        "dimension": {
          "enum": [
            "agent_profile",
            "execution_agent",
            "provider_kind",
            "vendor_family",
            "human"
          ]
        },
        "different_from": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        },
        "human_substitution_permitted": {
          "type": "boolean"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "target"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/non_empty_string"
        },
        "target": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "stage_budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_execution_attempts": {
          "description": "Retries of ONE execution binding, never a run total: a continuation is a different binding with its own allowance.",
          "type": "integer",
          "minimum": 1
        },
        "max_provider_invocations": {
          "description": "The RUN TOTAL of provider invocations, across every binding. A plan's remaining aggregate headroom is a total and is carried here.",
          "type": "integer",
          "minimum": 1
        },
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "budget_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_child_runs",
        "max_concurrency",
        "max_provider_invocations"
      ],
      "properties": {
        "max_child_runs": {
          "type": "integer",
          "minimum": 1
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "max_provider_invocations": {
          "type": "integer",
          "minimum": 1
        },
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost_micros": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "plan_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiler_version",
        "project_model",
        "policy",
        "contract"
      ],
      "properties": {
        "compiler_version": {
          "$ref": "#/$defs/non_empty_string"
        },
        "project_model": {
          "$ref": "#/$defs/object_revision"
        },
        "policy": {
          "$ref": "#/$defs/object_revision"
        },
        "contract": {
          "$ref": "#/$defs/object_revision"
        },
        "template": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "digest"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/non_empty_string"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "digest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "reasoning": {
          "$ref": "#/$defs/reasoning"
        },
        "previous_revision": {
          "type": "integer",
          "minimum": 1
        },
        "proposal_id": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "reasoning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "provider_kind",
        "trust_mode",
        "invocation_mode",
        "workspace_digest_before",
        "workspace_digest_after",
        "workspace_unchanged"
      ],
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "provider_kind": {
          "$ref": "#/$defs/non_empty_string"
        },
        "vendor_family": {
          "$ref": "#/$defs/non_empty_string"
        },
        "trust_mode": {
          "enum": [
            "operator_trusted",
            "protected"
          ]
        },
        "model": {
          "$ref": "#/$defs/non_empty_string"
        },
        "profile_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "invocation_mode": {
          "enum": [
            "mutating",
            "non_mutating_planning"
          ]
        },
        "provider_mode": {
          "$ref": "#/$defs/non_empty_string"
        },
        "workspace_digest_before": {
          "$ref": "#/$defs/digest"
        },
        "workspace_digest_after": {
          "$ref": "#/$defs/digest"
        },
        "workspace_unchanged": {
          "type": "boolean"
        },
        "invocation": {
          "$ref": "https://zenchron.engineering/schemas/v0.1/planning-vocabulary.schema.json#/$defs/invocation_observation"
        }
      }
    },
    "object_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "revision": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    }
  }
}
