{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "product_id",
      "name",
      "revision",
      "repositories"
    ],
    "properties": {
      "product_id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "revision": {
        "type": "integer"
      },
      "repositories": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
