{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenchron.engineering/schemas/v0.1/project-model.schema.json",
  "title": "ProjectModel v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "revision", "subject"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "id": { "$ref": "#/$defs/non_empty_string" },
    "revision": { "$ref": "#/$defs/non_empty_string" },
    "subject": { "$ref": "#/$defs/subject" },
    "critical_boundaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/critical_boundary" }
    },
    "test_capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/test_capability" }
    },
    "policy_profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision"],
      "properties": {
        "repository": { "$ref": "#/$defs/non_empty_string" },
        "revision": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "critical_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "paths"],
      "properties": {
        "id": { "$ref": "#/$defs/non_empty_string" },
        "type": { "$ref": "#/$defs/non_empty_string" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" },
          "uniqueItems": true
        }
      }
    },
    "test_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/non_empty_string" },
        "type": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  }
}
