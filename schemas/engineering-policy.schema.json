{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenchron.engineering/schemas/v0.1/engineering-policy.schema.json",
  "title": "EngineeringPolicy v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "revision": {
      "$ref": "#/$defs/non_empty_string"
    },
    "rules": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/non_empty_string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "fact_value": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact",
        "equals"
      ],
      "properties": {
        "fact": {
          "$ref": "#/$defs/non_empty_string"
        },
        "equals": {
          "$ref": "#/$defs/fact_value"
        },
        "stage": {
          "enum": [
            "predicted",
            "observed",
            "verified"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance_match"
        }
      }
    },
    "provenance_match": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "type": {
          "$ref": "#/$defs/non_empty_string"
        },
        "producer": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement"
      ],
      "properties": {
        "statement": {
          "$ref": "#/$defs/non_empty_string"
        },
        "required_claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "target"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/non_empty_string"
        },
        "target": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "authority_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "required_claims"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/action"
        },
        "required_claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        }
      }
    },
    "requirements": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/non_empty_string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/requirement"
      }
    },
    "required_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_class",
        "independent_from_change_producer"
      ],
      "properties": {
        "evidence_class": {
          "$ref": "#/$defs/non_empty_string"
        },
        "independent_from_change_producer": {
          "type": "boolean"
        }
      }
    },
    "required_claims": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/non_empty_string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/required_claim"
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "obligations": {
          "$ref": "#/$defs/requirements"
        },
        "invariants": {
          "$ref": "#/$defs/requirements"
        },
        "required_claims": {
          "$ref": "#/$defs/required_claims"
        },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "prohibitions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "authority_conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/authority_condition"
          }
        },
        "acceptance_discharge_claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "engineering_requirements": {
          "$ref": "#/$defs/engineering_requirements"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "when",
        "effect"
      ],
      "properties": {
        "when": {
          "$ref": "#/$defs/condition"
        },
        "effect": {
          "$ref": "#/$defs/effect"
        }
      }
    },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension"
      ],
      "properties": {
        "dimension": {
          "enum": [
            "agent_profile",
            "execution_agent",
            "provider_kind",
            "vendor_family",
            "human"
          ]
        },
        "different_from": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        },
        "human_substitution_permitted": {
          "type": "boolean"
        }
      }
    },
    "role_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "statement"
      ],
      "properties": {
        "role": {
          "enum": [
            "product_architect",
            "system_architect",
            "planner",
            "implementer",
            "tester",
            "security_reviewer",
            "reviewer",
            "integrator",
            "release_reviewer"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "requirements_analysis",
              "architecture_reasoning",
              "repository_analysis",
              "code_change",
              "verification",
              "security_review"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "independence": {
          "$ref": "#/$defs/independence"
        },
        "trust_requirement": {
          "enum": [
            "operator_trusted",
            "protected"
          ]
        },
        "statement": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "gate_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "statement"
      ],
      "properties": {
        "kind": {
          "enum": [
            "assurance_gate",
            "human_decision_gate"
          ]
        },
        "required_claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "statement": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "engineering_requirements": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/role_requirement"
          },
          "minItems": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "requirements_analysis",
              "architecture_reasoning",
              "repository_analysis",
              "code_change",
              "verification",
              "security_review"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "gates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gate_requirement"
          },
          "minItems": 1
        }
      }
    }
  }
}
