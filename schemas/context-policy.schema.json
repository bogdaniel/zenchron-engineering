{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenchron.engineering/schemas/v0.1/context-policy.schema.json",
  "title": "ContextPolicy v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "digest",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "revision": {
      "$ref": "#/$defs/non_empty_string"
    },
    "digest": {
      "$ref": "#/$defs/digest"
    },
    "source": {
      "$ref": "#/$defs/artifact_source"
    },
    "include": {
      "type": "array",
      "items": {
        "enum": [
          "objective",
          "acceptance_criteria",
          "obligations",
          "permissions",
          "prohibitions",
          "project_model_facts",
          "architecture_notes",
          "policy_excerpts",
          "repository_paths",
          "upstream_stage_outputs",
          "candidate_diff",
          "prior_findings",
          "producer_reasoning"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "exclude": {
      "type": "array",
      "items": {
        "enum": [
          "objective",
          "acceptance_criteria",
          "obligations",
          "permissions",
          "prohibitions",
          "project_model_facts",
          "architecture_notes",
          "policy_excerpts",
          "repository_paths",
          "upstream_stage_outputs",
          "candidate_diff",
          "prior_findings",
          "producer_reasoning"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "location"
      ],
      "properties": {
        "type": {
          "enum": [
            "operator_config",
            "operator_file"
          ]
        },
        "location": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    }
  }
}
