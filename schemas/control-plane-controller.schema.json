{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "durable_consistency",
    "serving",
    "projection",
    "generation_match",
    "role",
    "work_admission",
    "live_reachable"
  ],
  "$defs": {
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "source_revision": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "durable_consistency": {
      "type": "string",
      "enum": [
        "consistent",
        "invariant_violation",
        "snapshot_unstable",
        "no_activation_recorded"
      ]
    },
    "serving": {
      "type": "string",
      "enum": [
        "serving",
        "not_serving",
        "unknown"
      ]
    },
    "projection": {
      "type": "string",
      "enum": [
        "current",
        "drift",
        "missing",
        "invalid"
      ]
    },
    "generation_match": {
      "type": "string",
      "enum": [
        "match",
        "mismatch",
        "unknown"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "",
        "held",
        "not_held"
      ]
    },
    "work_admission": {
      "type": "string",
      "enum": [
        "",
        "open",
        "withheld",
        "closed"
      ]
    },
    "durable_generation": {
      "$ref": "#/$defs/build"
    },
    "live_reachable": {
      "type": "boolean"
    },
    "live_build": {
      "$ref": "#/$defs/build"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "controller_binding": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
