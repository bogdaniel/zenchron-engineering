{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "receipts"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "digest",
          "decision",
          "sequence",
          "occurred_at"
        ],
        "properties": {
          "request_id": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          },
          "decision": {
            "enum": [
              "approve",
              "reject"
            ]
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
