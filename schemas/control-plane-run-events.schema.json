{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "events",
    "next_after",
    "has_more"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "type",
          "occurred_at"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "type": "string"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "next_after": {
      "type": "integer",
      "minimum": 0
    },
    "has_more": {
      "type": "boolean"
    }
  }
}
