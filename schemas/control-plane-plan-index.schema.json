{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["plans", "offset", "has_more"],
  "properties": {
    "offset": {"type": "integer", "minimum": 0},
    "has_more": {"type": "boolean"},
    "plans": {"type": "array", "maxItems": 50, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_id", "repository", "current_revision", "pending", "shown"],
      "properties": {
        "plan_id": {"type": "string"}, "repository": {"type": "string"},
        "current_revision": {"type": "integer", "minimum": 0},
        "source_issue": {"type": "integer", "minimum": 1},
        "pending": {"type": "boolean"},
        "lifecycle": {"$ref": "control-plane-plan.schema.json"},
        "shown": {"enum": ["attempt_only", "governing", "proposed", "superseded", "rejected", "unapproved"]}
      }
    }}
  }
}
