{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workgraphs",
    "offset",
    "has_more"
  ],
  "properties": {
    "workgraphs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "graph_id",
          "repository",
          "agent_id",
          "name",
          "revision"
        ],
        "properties": {
          "objective_plan_id": {
            "type": "string",
            "minLength": 1
          },
          "graph_id": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "agent_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          }
        }
      }
    },
    "offset": {
      "type": "integer"
    },
    "has_more": {
      "type": "boolean"
    }
  }
}
