{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenchron.engineering/schemas/v0.1/engineering-plan.schema.json",
  "title": "EngineeringPlan v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "digest",
    "objective",
    "subject",
    "budget_envelope",
    "stages",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "digest": {
      "$ref": "#/$defs/digest"
    },
    "objective": {
      "$ref": "#/$defs/non_empty_string"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "budget_envelope": {
      "$ref": "#/$defs/budget_envelope"
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/plan_stage",
        "allOf": [
          {
            "description": "A gate is not performed by a worker: it references evidence, authority or a human decision that already exists. Stating a worker requirement on one is refused here as well as in Go, so a document that says it is never accepted as a plan.",
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "assurance_gate",
                    "human_decision_gate"
                  ]
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "role"
                    ]
                  },
                  {
                    "required": [
                      "profile"
                    ]
                  },
                  {
                    "required": [
                      "independence"
                    ]
                  },
                  {
                    "required": [
                      "requires_capabilities"
                    ]
                  },
                  {
                    "required": [
                      "trust_requirement"
                    ]
                  },
                  {
                    "required": [
                      "invocation_mode"
                    ]
                  }
                ]
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "provenance": {
      "$ref": "#/$defs/plan_provenance"
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/non_empty_string"
        },
        "revision": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "plan_stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "kind": {
          "enum": [
            "agent",
            "assurance_gate",
            "human_decision_gate"
          ]
        },
        "role": {
          "enum": [
            "product_architect",
            "system_architect",
            "planner",
            "implementer",
            "tester",
            "security_reviewer",
            "reviewer",
            "integrator",
            "release_reviewer"
          ]
        },
        "objective": {
          "$ref": "#/$defs/non_empty_string"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "requires_capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "requirements_analysis",
              "architecture_reasoning",
              "repository_analysis",
              "code_change",
              "verification",
              "security_review"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "independence": {
          "$ref": "#/$defs/independence"
        },
        "trust_requirement": {
          "enum": [
            "operator_trusted",
            "protected"
          ]
        },
        "invocation_mode": {
          "enum": [
            "mutating",
            "non_mutating_planning"
          ]
        },
        "profile": {
          "$ref": "#/$defs/non_empty_string"
        },
        "context_policy": {
          "$ref": "#/$defs/non_empty_string"
        },
        "required_claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "budget": {
          "$ref": "#/$defs/stage_budget"
        },
        "rationale": {
          "$ref": "#/$defs/non_empty_string"
        },
        "substitutes_role": {
          "enum": [
            "product_architect",
            "system_architect",
            "planner",
            "implementer",
            "tester",
            "security_reviewer",
            "reviewer",
            "integrator",
            "release_reviewer"
          ]
        }
      }
    },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "different_from"
      ],
      "properties": {
        "dimension": {
          "enum": [
            "agent_profile",
            "execution_agent",
            "provider_kind",
            "vendor_family",
            "human"
          ]
        },
        "different_from": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        },
        "human_substitution_permitted": {
          "type": "boolean"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "target"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/non_empty_string"
        },
        "target": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "stage_budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_execution_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "budget_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_child_runs",
        "max_concurrency",
        "max_provider_invocations"
      ],
      "properties": {
        "max_child_runs": {
          "type": "integer",
          "minimum": 1
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "max_provider_invocations": {
          "type": "integer",
          "minimum": 1
        },
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost_micros": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "plan_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiler_version",
        "project_model",
        "policy",
        "contract"
      ],
      "properties": {
        "compiler_version": {
          "$ref": "#/$defs/non_empty_string"
        },
        "project_model": {
          "$ref": "#/$defs/object_revision"
        },
        "policy": {
          "$ref": "#/$defs/object_revision"
        },
        "contract": {
          "$ref": "#/$defs/object_revision"
        },
        "template": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "digest"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/non_empty_string"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "digest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "reasoning": {
          "$ref": "#/$defs/reasoning"
        },
        "previous_revision": {
          "type": "integer",
          "minimum": 1
        },
        "proposal_id": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "reasoning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "provider_kind",
        "trust_mode",
        "invocation_mode",
        "workspace_digest_before",
        "workspace_digest_after",
        "workspace_unchanged"
      ],
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "provider_kind": {
          "$ref": "#/$defs/non_empty_string"
        },
        "vendor_family": {
          "$ref": "#/$defs/non_empty_string"
        },
        "trust_mode": {
          "enum": [
            "operator_trusted",
            "protected"
          ]
        },
        "model": {
          "$ref": "#/$defs/non_empty_string"
        },
        "profile_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "invocation_mode": {
          "enum": [
            "mutating",
            "non_mutating_planning"
          ]
        },
        "provider_mode": {
          "$ref": "#/$defs/non_empty_string"
        },
        "workspace_digest_before": {
          "$ref": "#/$defs/digest"
        },
        "workspace_digest_after": {
          "$ref": "#/$defs/digest"
        },
        "workspace_unchanged": {
          "type": "boolean"
        }
      }
    },
    "object_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "revision": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    }
  }
}
