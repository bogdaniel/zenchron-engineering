{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agentkernel.execution/v0.2 ExecutionRequest",
  "description": "Mirrors api.ExecutionRequest. api.DecodeRequest refuses unknown fields, duplicate keys and trailing data; ExecutionRequest.Validate(now) is authoritative. Rules enforced ONLY by Validate (not expressible here): budget.deadline must be after the validation time; context ids, grant handles, command names (per grant) and provider ids must be unique; every context item's content_digest must equal api.Digest(content); with budget.money, every eligible binding's pricing currency must equal money.currency; objective is limited to 65536 BYTES (maxLength below counts code points) and must contain a non-space character by unicode.IsSpace; a root's drive-letter check is per byte. Go's decoder does not require keys to be present, so a missing array or boolean decodes to its zero value and is then judged by Validate; this schema requires every non-omitempty field.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "execution_id", "attempt_id", "objective", "mode", "workspace", "constraints", "context", "grants", "budget", "providers"],
  "properties": {
    "version": {"$ref": "common.v0.2.schema.json#/$defs/version"},
    "execution_id": {"$ref": "common.v0.2.schema.json#/$defs/identifier"},
    "attempt_id": {"$ref": "common.v0.2.schema.json#/$defs/identifier"},
    "objective": {"type": "string", "minLength": 1, "maxLength": 65536, "pattern": "\\S"},
    "mode": {"$ref": "#/$defs/mode"},
    "workspace": {"$ref": "#/$defs/workspace"},
    "constraints": {"$ref": "#/$defs/constraints"},
    "context": {"type": "array", "items": {"$ref": "#/$defs/context_item"}},
    "grants": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
    "budget": {"$ref": "#/$defs/budget"},
    "providers": {
      "description": "At least one binding; at most one pinned.",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/provider_binding"},
      "contains": {"type": "object", "required": ["pinned"], "properties": {"pinned": {"const": true}}},
      "minContains": 0,
      "maxContains": 1
    }
  },
  "allOf": [
    {
      "description": "read_only admits only file.read and file.search grants.",
      "if": {"required": ["mode"], "properties": {"mode": {"const": "read_only"}}},
      "then": {"properties": {"grants": {"items": {"properties": {"kind": {"enum": ["file.read", "file.search"]}}}}}}
    },
    {
      "description": "A money ceiling requires trusted pricing on every eligible binding (currency equality is checked only by Validate).",
      "if": {"required": ["budget"], "properties": {"budget": {"required": ["money"]}}},
      "then": {
        "properties": {
          "providers": {
            "items": {
              "if": {"required": ["eligible"], "properties": {"eligible": {"const": true}}},
              "then": {"required": ["pricing"]}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "mode": {"description": "api.Mode.", "enum": ["read_only", "read_write"]},
    "workspace": {
      "description": "api.WorkspaceRef.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "manifest_digest", "dirty"],
      "properties": {
        "id": {"$ref": "common.v0.2.schema.json#/$defs/identifier"},
        "manifest_digest": {"$ref": "common.v0.2.schema.json#/$defs/sha256_digest"},
        "git_revision": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
        "dirty": {"type": "boolean"}
      }
    },
    "constraints": {
      "description": "api.Constraints.",
      "type": "object",
      "additionalProperties": false,
      "required": ["require_host_proven_isolation", "instruction_digest"],
      "properties": {
        "required_features": {
          "description": "api.SupportedFeatures; an unsupported feature refuses the request.",
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["tools", "artifacts", "cancellation_provenance"]}
        },
        "require_host_proven_isolation": {"type": "boolean"},
        "instruction_digest": {"$ref": "common.v0.2.schema.json#/$defs/sha256_digest"}
      }
    },
    "context_item": {
      "description": "api.ContextItem. instruction and constraint items require host trust. content_digest must equal api.Digest(content) (Validate only).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "trust", "required", "content", "content_digest"],
      "properties": {
        "id": {"$ref": "common.v0.2.schema.json#/$defs/identifier"},
        "kind": {"$ref": "common.v0.2.schema.json#/$defs/context_kind"},
        "trust": {"$ref": "common.v0.2.schema.json#/$defs/trust"},
        "required": {"type": "boolean"},
        "content": {"type": "string"},
        "content_digest": {"$ref": "common.v0.2.schema.json#/$defs/sha256_digest"},
        "revision": {"type": "string"},
        "ref": {"$ref": "common.v0.2.schema.json#/$defs/artifact_ref"},
        "score": {"type": "number"}
      },
      "if": {"required": ["kind"], "properties": {"kind": {"enum": ["instruction", "constraint"]}}},
      "then": {"properties": {"trust": {"const": "host"}}}
    },
    "capability_kind": {"description": "api.CapabilityKind.", "enum": ["file.read", "file.search", "file.write", "command.run"]},
    "capability": {
      "description": "api.Capability. command.run takes commands and no roots; file kinds take roots and no commands.",
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "kind"],
      "properties": {
        "handle": {"$ref": "common.v0.2.schema.json#/$defs/identifier"},
        "kind": {"$ref": "#/$defs/capability_kind"},
        "roots": {"type": "array", "items": {"$ref": "#/$defs/relative_path"}},
        "commands": {"type": "array", "items": {"$ref": "#/$defs/command_grant"}}
      },
      "if": {"required": ["kind"], "properties": {"kind": {"const": "command.run"}}},
      "then": {"required": ["commands"], "properties": {"commands": {"minItems": 1}, "roots": {"maxItems": 0}}},
      "else": {"required": ["roots"], "properties": {"roots": {"minItems": 1}, "commands": {"maxItems": 0}}}
    },
    "relative_path": {
      "description": "api.ValidRelativePath: \".\" or a clean slash-separated workspace-relative path with no \".\"/\"..\" segment, empty segment, trailing or leading slash, backslash, NUL or drive letter.",
      "type": "string",
      "minLength": 1,
      "anyOf": [
        {"const": "."},
        {"not": {"pattern": "(^|/)\\.\\.?(/|$)|//|/$|^/|\\\\|\\x00|^.:"}}
      ]
    },
    "command_grant": {
      "description": "api.CommandGrant.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "argv", "timeout_seconds"],
      "properties": {
        "name": {"$ref": "common.v0.2.schema.json#/$defs/identifier"},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "timeout_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "budget": {
      "description": "api.Budget: the envelope of the whole execution (every attempt of one execution_id together; a later attempt may not widen a cumulative bound and starts from what earlier attempts consumed, execution spec 11.1). deadline is attempt-scoped: a new attempt_id may carry a later one. deadline must be after the validation time (Validate only).",
      "type": "object",
      "additionalProperties": false,
      "required": ["deadline", "max_iterations", "max_tool_calls", "max_input_tokens", "max_output_tokens", "max_artifact_bytes", "max_provider_retries"],
      "properties": {
        "deadline": {"$ref": "common.v0.2.schema.json#/$defs/timestamp"},
        "max_iterations": {"type": "integer", "minimum": 1},
        "max_tool_calls": {"type": "integer", "minimum": 1},
        "max_input_tokens": {"type": "integer", "minimum": 1},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "max_artifact_bytes": {"type": "integer", "minimum": 1},
        "max_provider_retries": {"type": "integer", "minimum": 0, "maximum": 10},
        "money": {"$ref": "#/$defs/money_ceiling"}
      }
    },
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "money_ceiling": {
      "description": "api.MoneyCeiling.",
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "max_micros"],
      "properties": {
        "currency": {"$ref": "#/$defs/currency"},
        "max_micros": {"type": "integer", "minimum": 1}
      }
    },
    "provider_binding": {
      "description": "api.ProviderBinding. Holds no credential value. A pinned binding must be eligible.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "model", "model_version", "config_fingerprint", "eligible", "pinned", "preference", "isolation", "context_window", "max_output_tokens"],
      "properties": {
        "id": {"$ref": "common.v0.2.schema.json#/$defs/identifier"},
        "kind": {"$ref": "common.v0.2.schema.json#/$defs/identifier"},
        "model": {"type": "string", "minLength": 1},
        "model_version": {"description": "Literal \"unknown\" when the host cannot pin it.", "type": "string", "minLength": 1},
        "features": {"type": "array", "items": {"type": "string"}},
        "config_fingerprint": {"type": "string", "minLength": 1},
        "eligible": {"type": "boolean"},
        "pinned": {"type": "boolean"},
        "preference": {"type": "integer"},
        "isolation": {"$ref": "common.v0.2.schema.json#/$defs/isolation"},
        "context_window": {"type": "integer", "minimum": 1},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "credential_handle": {"$ref": "common.v0.2.schema.json#/$defs/identifier"},
        "pricing": {"$ref": "#/$defs/pricing"}
      },
      "if": {"required": ["pinned"], "properties": {"pinned": {"const": true}}},
      "then": {"properties": {"eligible": {"const": true}}}
    },
    "pricing": {
      "description": "api.Pricing: a trusted host rate card. Absent pricing means unknown cost, never zero.",
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "input_micros_per_million", "output_micros_per_million", "cached_input_micros_per_million", "cache_write_input_micros_per_million", "source", "version", "observed_at"],
      "properties": {
        "currency": {"$ref": "#/$defs/currency"},
        "input_micros_per_million": {"type": "integer", "minimum": 0},
        "output_micros_per_million": {"type": "integer", "minimum": 0},
        "cached_input_micros_per_million": {"type": ["integer", "null"], "minimum": 0, "description": "Rate for input tokens read from a provider cache, charged instead of the input rate. null is unknown, never zero; a money ceiling needs it known."},
        "cache_write_input_micros_per_million": {"type": ["integer", "null"], "minimum": 0, "description": "Rate for input tokens written to a provider cache, charged instead of the input rate. null is unknown, never zero; a money ceiling needs it known."},
        "source": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "observed_at": {"$ref": "common.v0.2.schema.json#/$defs/timestamp"}
      }
    }
  }
}
